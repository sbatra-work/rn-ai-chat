# Copy to server/.env. Every line is optional.
# With no key the server runs in fake mode: no network, same answers every time.

# "fake" or "openai". Defaults to "openai" when LLM_API_KEY is set, else "fake".
LLM_MODE=fake

# Key for any OpenAI-compatible service. Lives on the server only.
LLM_API_KEY=

# OpenAI by default. Also works with OpenRouter, Groq, or a local Ollama.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Requests allowed per device in each window.
RATE_LIMIT=20
RATE_WINDOW_MS=60000

# Pause between tokens in fake mode, in milliseconds.
FAKE_DELAY_MS=35

PORT=8787
